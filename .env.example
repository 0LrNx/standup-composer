# Generated by `python install.py` — you can also fill this in by hand.

# Ticket source: linear (default) or azure_devops_boards
TICKET_PROVIDER=linear
# Code source: github (default) or azure_devops_repos
CODE_PROVIDER=github
# Notification channel: slack (default), teams, or none
NOTIFY_PROVIDER=slack

# Linear (used when TICKET_PROVIDER=linear)
LINEAR_TOKEN=your-linear-token

# GitHub (used when CODE_PROVIDER=github)
GITHUB_TOKEN=your-github-token
GITHUB_USERNAME=your-github-username

# Azure DevOps (used when TICKET_PROVIDER=azure_devops_boards and/or CODE_PROVIDER=azure_devops_repos)
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=your-personal-access-token
# Required when CODE_PROVIDER=azure_devops_repos — without it, PRs/reviews for the whole
# project are returned instead of just yours. `python install.py` resolves this for you.
AZURE_DEVOPS_USER_ID=your-azure-devops-user-guid

# Slack (used when NOTIFY_PROVIDER=slack)
SLACK_WEBHOOK_URL=your-slack-webhook-url

# Teams (used when NOTIFY_PROVIDER=teams)
TEAMS_WEBHOOK_URL=your-teams-webhook-url
